{
  "name": "quest-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quest Lite — Construction CRM & Business Operations Platform (Prospecting, Underwriting, Sales, Production).",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "tsx server/scripts/reset-db.ts",
    "db:seed": "tsx server/scripts/seed.ts",
    "deploy:build": "vite build",
    "deploy:hosting": "npm run deploy:build && firebase deploy --only hosting",
    "deploy:check": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "firebase": "^11.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.19.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.10",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.0.8"
  }
}
