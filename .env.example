# Quest Lite environment
# Copy to .env and adjust. The app runs with safe defaults if .env is absent.

# Port the API server listens on.
PORT=4000

# Where the local working copy of the database lives. Firestore is the
# database of record; this SQLite file is the working copy the API queries.
DATABASE_PATH=./data/quest-lite.sqlite

# ------------------------------------------------------------------
# Firebase (Firestore = database of record, project `quest-lite`)
# ------------------------------------------------------------------
# Every table is mirrored to a Firestore collection of the same name and pulled
# back on boot, so the data in the Firebase console is always current. Set to 0
# to run with no Firebase dependency at all (the test suite does this).
# See docs/firebase.md.
FIRESTORE_SYNC=1

# Service-account key used to reach Firebase. Defaults to the
# ./firebase-service-account.json in the project root; set this to a path (or
# paste the JSON) to use a different key. Application default credentials are
# used when neither is present and GOOGLE_APPLICATION_CREDENTIALS is set.
# FIREBASE_SERVICE_ACCOUNT=

# ------------------------------------------------------------------
# Google sign-in (Optional)
# ------------------------------------------------------------------
# OAuth 2.0 Web client ID(s) from Google Cloud console → APIs & Services →
# Credentials. Comma-separate multiple IDs (e.g. one for local dev, one for
# the deployed site). While this is empty the "Continue with Google" button is
# hidden and email/password sign-in is used. Setup steps: docs/google-signin.md
# GOOGLE_CLIENT_ID=

# Secret used to sign session tokens. REQUIRED in production; a dev fallback is
# used otherwise. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Directory where uploaded files are stored.
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------------
# Communication integrations (Optional — clearly separated test/live mode)
# ------------------------------------------------------------------
# SMS provider. Leave empty to run the app in DRAFT/TEST mode, where text
# messages are recorded as drafts and NEVER reported as delivered.
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=

# Email provider. Leave empty to run in DRAFT/TEST mode.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# ------------------------------------------------------------------
# Electronic signature integration (Optional)
# ------------------------------------------------------------------
ESIGN_PROVIDER=
ESIGN_API_KEY=

# ------------------------------------------------------------------
# Payment / deposit integration (Optional)
# ------------------------------------------------------------------
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=

# Force communication integrations into test mode even when keys are present.
# 1 = always draft. Set to 0 to enable live sending once providers are configured.
COMMS_FORCE_TEST_MODE=1

# ------------------------------------------------------------------
# Split deployment (Firebase Hosting SPA + API on a separate origin)
# ------------------------------------------------------------------
# The Spark (free) Firebase plan can only host static files — it cannot run
# Cloud Functions or Cloud Run — so a split deployment puts the SPA on Firebase
# Hosting and the Express API somewhere else. Both then talk cross-origin.
#
# Set this to a comma-separated list of EXACT origins allowed to call the API.
# A wildcard cannot be used with credentialed cookies, so the list is explicit.
#   CORS_ORIGINS=https://quest-lite.web.app,http://localhost:5173
#
# Leave empty for a same-origin deployment (SPA and API served together, or the
# Vite dev server proxy) — no CORS headers are emitted and cookies stay Lax.
CORS_ORIGINS=

# Allow any localhost/127.0.0.1 port during development even when CORS_ORIGINS
# is set. Set to false to enforce the allow-list strictly. Default: true.
CORS_ALLOW_LOCALHOST=true

